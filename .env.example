# ==========================================
# SkyPort Airlines - Environment Variables Template
# ==========================================
# Copy this file to .env for local testing or add these variables in your Vercel Project Settings -> Environment Variables.

# --- Database Configuration (Optional Remote MySQL) ---
DB_HOST=localhost
DB_USER=root
DB_PASS=
DB_NAME=airport

# --- SMTP Email Configuration (For Sending Ticket & Boarding Pass Emails) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_digit_app_password
SMTP_FROM_EMAIL=no-reply@skyport.com
SMTP_FROM_NAME=SkyPort Airlines

# --- SMS API Configuration (Fast2SMS / 2Factor) ---
SMS_API_KEY=your_fast2sms_api_key_here
