{
  "version": 2,
  "name": "skyport-airline-booking",
  "functions": {
    "api/*.php": {
      "runtime": "vercel-php@0.7.1"
    },
    "*.php": {
      "runtime": "vercel-php@0.7.1"
    },
    "admin/*.php": {
      "runtime": "vercel-php@0.7.1"
    },
    "Flights/*.php": {
      "runtime": "vercel-php@0.7.1"
    }
  },
  "routes": [
    {
      "src": "/(css|js|images|screenshots|data|Flights/logo|AdminLte)/(.*)",
      "dest": "/$1/$2"
    },
    {
      "src": "/(.*\\.(css|js|png|jpg|jpeg|gif|ico|svg|pdf|webp|woff|woff2|ttf|eot))",
      "dest": "/$1"
    },
    {
      "src": "/admin/(.*)",
      "dest": "/admin/$1"
    },
    {
      "src": "/Flights/(.*)",
      "dest": "/Flights/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
